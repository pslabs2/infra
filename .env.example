# Copy to .env (git-ignored) and fill in. Missing values are prompted for.

# API token: Account > Cloudflare Tunnel > Edit, Zone > DNS > Edit, Zone > Read,
# and Account > Access: Apps and Policies > Edit (for --access).
CLOUDFLARE_API_TOKEN=

# Optional: auto-detected when the token covers a single account.
# Found in the dashboard URL or the domain's Overview page sidebar.
CLOUDFLARE_ACCOUNT_ID=

# Optional overrides.
# CLOUDFLARE_DOMAIN=pukarsubedi.com
# CLOUDFLARE_TUNNEL_NAME=homelab
# CLOUDFLARE_TUNNEL_TOKEN=   # skip the API and use this token for 'secret'
